* {
    font-family: "Roboto Mono";
}

QLabel, QPushButton, QToolButton {
    color: #1E1E1E
}

#main_container {
    background-color: #D7F0FE;
}

GameOverDialog {
    background-color: #D7F0FE;
}

#post_game_result_container[game_result="won"] {
    background-color: #BBFF6D;
    border-radius: 10px;
}

#post_game_result_container[game_result="lost"] {
    background-color: #BE7E70;
    border-radius: 10px;
}

#post_game_result_container[game_result="gave_up"] {
    background-color: #8D8D8D;
    border-radius: 10px;
}

#post_game_result_label {
    font-size: 32pt;
    font-weight: bold;
}

#post_game_answer_label {
    font-size: 14pt;
}

#post_game_play_again_button {
    font-size: 18pt;
    background-color: #96D7FF;
    padding: 10px;
    font-weight: medium;
}

#play_again_button {
    font-size: 16pt;
    border-radius: 8;
    background-color: #96D7FF;
    padding: 10px;
    font-weight: bold;
}

#post_game_close_button {
    background-color: red;
    font-weight: bold;
    border: none;
    padding: 5px;
}

BlockSwitchModeDialog {
    background-color: #D7F0FE;
}

#block_switch_mode_stop_header_label {
    background-color: #FF8686;
    font-weight: bold;
    font-size: 32pt;
    padding: 10px;
    border-radius: 8;
}

#block_switch_mode_contents_label {
    font-size: 13pt;
}

#block_switch_mode_ok_button {
    background-color: #96D7FF;
    font-weight: bold;
    font-size: 16pt;
    padding: 10px;
    border-radius: 8;

}

Topbar {
   background-color: #FFED6D;
   padding: 10px;
}

/*
Topbar QToolButton {
    background-color: #ffffff
}
*/

#title_label {
    font-size: 42pt;
    font-weight: bold;
}

#letter_grid_area {
    border-radius: 20;
}

#letter_grid_area[mode="daily"] {
    background-color: #3873E9;
}

#letter_grid_area[mode="unlimited"] {
    background-color: #A541FC;
}

#letter_grid_header_label {
    font-size: 24pt;
    font-weight: bold;
}

WordeeCell {
    background-color: #f5f5f5;
    border-radius: 0;
    font-size: 28pt;
    font-weight: bold;
}

WordeeCell[color="gray"] {
    background-color: #a0a0a0;
}

WordeeCell[color="yellow"] {
    background-color: #FFD400;
}

WordeeCell[color="green"] {
    background-color: #65E510;
}

#puzzle_number_label {
    font-size: 32pt;
    font-weight: bold;
}

GameStats {
    background-color: #dbdbdb;
    border-radius: 12;
    padding: 10;
}

QLabel[class="game_stats_label"] {
    font-size: 14pt;
}

LetterStatuses {
    background-color: #E0536F;
    border-radius: 20;
}

#letter_statuses_header_label {
    font-weight: bold;
    font-size: 24pt;
}

WordeeStatusKey {
    background-color: #dbdbdb;
    border-radius: 0;
    font-size: 18pt;
}

WordeeStatusKey[color="gray"] {
    background-color: #a0a0a0;
}

WordeeStatusKey[color="yellow"] {
    background-color: #FFD400;
}

WordeeStatusKey[color="green"] {
    background-color: #65E510;
}

#backspace_key {
    background-color: #a1a0a0;
    font-size: 18pt;
    border-radius: 0;
    padding: 10px;
}

#enter_key {
    background-color: #7fbc8d;
    font-size: 18pt;
    font-weight: bold;
    border-radius: 0;
    padding: 10px;
}

#game_stats_label_header {
    font-weight: bold;
    font-size: 24pt;
}

#give_up_button {
    font-size: 16pt;
    border-radius: 8;
    background-color: #a0a0a0;
    border: none;
    padding: 10px;
}

#switch_modes_button {
    font-size: 16pt;
    border-radius: 8;
    background-color: #A791FF;
    border: none;
    font-weight: bold;
    padding: 10px;
}

#switch_modes_button[mode="daily"] {
    background-color: #6493F0;
}

#switch_modes_button[mode="unlimited"] {
    background-color: #A791FF;
}
